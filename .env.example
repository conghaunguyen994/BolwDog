# 1. Supabase API Configuration (Optional for initial local demo mode)
# When left empty, BolwDog runs in high-fidelity mock mode with full checkout & demo data.
# When provided, BolwDog seamlessly switches to your live Supabase database & storage!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# NOTE FOR DEVELOPERS:
# NEVER place the SUPABASE_SERVICE_ROLE_KEY in frontend code or in client .env!

