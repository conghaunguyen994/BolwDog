# ===================================================================
# BOLWDOG PET SHOP - ENVIRONMENT VARIABLES EXAMPLE
# Copy file nay thanh ".env" de chay local (KHONG day file .env len GitHub!)
# Khi deploy Vercel: Khai bao toan bo bien nay trong Project Settings -> Environment Variables
# ===================================================================

# -------------------------------------------------------------------
# 1. FRONTEND (Vite Browser - Chi dung Public URL & Anon/Publishable Key co RLS)
# -------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-or-publishable-key

# -------------------------------------------------------------------
# 2. SERVERLESS BACKEND ONLY (Vercel /api/* - BI MAT, TUYET DOI KHONG them VITE_)
# -------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-or-publishable-key

# Supabase Service Role Key (Supabase -> Project Settings -> API -> service_role)
# Bat buoc de /api/sepay-webhook & /api/check-sepay xac nhan thanh toan va an toan truoc tan cong anon
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# SePay API Key (https://my.sepay.vn -> Cau hinh Cong ty -> API Access)
SEPAY_API_KEY=your_sepay_api_token_here

# Secret tuy chon de xac thuc header Authorization tu SePay Webhook
# (Neu de trong, server dung SEPAY_API_KEY hoac tu doi chieu giao dich that qua SePay API)
SEPAY_WEBHOOK_SECRET=

# Gmail SMTP chinh chu (Uu tien so 1 - vao Inbox tot hon Google Apps Script)
# Tao App Password 16 ky tu tai: https://myaccount.google.com/apppasswords (can bat Xac minh 2 buoc)
GMAIL_SMTP_USER=your-gmail@gmail.com
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_FROM_NAME=Ú òa Shop

# Google Apps Script Webhook URL (du phong - gui Gmail tu server, khong luu trong DB)
EMAIL_WEBHOOK_URL=

# EmailJS REST API Credentials (tuy chon - dung tren server, khong luu trong DB)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
